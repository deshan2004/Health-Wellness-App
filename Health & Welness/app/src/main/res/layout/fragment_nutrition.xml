<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profile_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/primary_green"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/habits_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/eating_habits"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tracker_subtitle"
            app:layout_constraintStart_toEndOf="@id/profile_image"
            app:layout_constraintTop_toTopOf="@id/profile_image"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tracker_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nutrition_tracker"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/profile_image"
            app:layout_constraintStart_toStartOf="@id/habits_title"
            app:layout_constraintTop_toBottomOf="@id/habits_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notification_button"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/white"
            app:icon="@android:drawable/ic_popup_reminder"
            app:iconTint="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="@id/profile_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_image"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <!-- Nutrition Tip Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tip_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#F0FDF4"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/profile_image"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tip_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_nutrition_tip"
                    android:textColor="@color/primary_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@android:drawable/ic_menu_today"
                    app:drawableTint="@color/primary_green"
                    android:drawablePadding="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/eat_the_rainbow"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tip_label" />

                <TextView
                    android:id="@+id/tip_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/eat_the_rainbow_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tip_title" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tip_desc">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/calorie_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:progress="80"
                        app:indicatorColor="@color/primary_green"
                        app:trackColor="@color/white"
                        app:trackThickness="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/calorie_progress"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kcal_goal"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_goal"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </RelativeLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Macros Row -->
        <LinearLayout
            android:id="@+id/macros_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tip_card">

            <!-- Protein -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_protein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="#EF4444" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/protein"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="128g"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:progress="70"
                        app:indicatorColor="@color/primary_green"
                        app:trackColor="#F1F5F9"
                        app:trackThickness="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carbs -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_carbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="#F59E0B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/carbs"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="240g"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:progress="50"
                        app:indicatorColor="#F59E0B"
                        app:trackColor="#F1F5F9"
                        app:trackThickness="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fats -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_fats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="#84CC16" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fats"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="62g"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:progress="30"
                        app:indicatorColor="#BFDBFE"
                        app:trackColor="#F1F5F9"
                        app:trackThickness="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Food Picks Header -->
        <TextView
            android:id="@+id/picks_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/healthy_food_picks"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/macros_layout" />

        <TextView
            android:id="@+id/btn_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_all"
            android:textColor="@color/primary_green"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/picks_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/picks_label" />

        <!-- Food Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            app:layout_constraintTop_toBottomOf="@id/picks_label">

            <!-- Avocado -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_avocado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_avocado"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#F0FDF4" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="Healthy Fats" android:textColor="@color/primary_green" android:textSize="9sp" android:textStyle="bold" />
                    </RelativeLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Avocado" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="160kcal • 15g fat • 2g prot" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:background="@color/primary_green" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:background="#F59E0B" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#BFDBFE" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Salmon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_salmon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_salmon"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#F0FDF4" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="Omega-3 Rich" android:textColor="@color/primary_green" android:textSize="9sp" android:textStyle="bold" />
                    </RelativeLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Salmon" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="208kcal • 13g fat • 20g prot" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="@color/primary_green" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#F59E0B" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="#BFDBFE" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Broccoli -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_broccoli"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_broccoli"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#F0FDF4" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="Fiber Rich" android:textColor="@color/primary_green" android:textSize="9sp" android:textStyle="bold" />
                    </RelativeLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Broccoli" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="55kcal • 0.6g fat • 3.7g prot" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5" android:background="@color/primary_green" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#F59E0B" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#BFDBFE" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Blueberries -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_blueberries"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_blueberries"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#F0FDF4" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="Antioxidants" android:textColor="@color/primary_green" android:textSize="9sp" android:textStyle="bold" />
                    </RelativeLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Blueberries" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="84kcal • 0.5g fat • 1.1g prot" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6" android:background="@color/primary_green" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#F59E0B" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#BFDBFE" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Eggs -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_eggs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_eggs"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#F0FDF4" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="High Protein" android:textColor="@color/primary_green" android:textSize="9sp" android:textStyle="bold" />
                    </RelativeLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Eggs" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="155kcal • 11g fat • 13g prot" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="@color/primary_green" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:background="#F59E0B" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="#BFDBFE" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chicken -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_chicken"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_chicken"
